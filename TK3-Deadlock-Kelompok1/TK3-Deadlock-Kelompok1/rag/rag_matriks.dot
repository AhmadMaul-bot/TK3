// RAG keadaan saat ini dari matriks Allocation (kasus checkout UMKM)
// Panah R -> P = sumber daya dipegang proses; angka = jumlah unit.
// Tidak ada panah P -> R (tidak ada permintaan yang sedang menunggu), sehingga tidak ada siklus.
digraph RAG_Matriks {
  graph [rankdir=TB, nodesep=0.7, ranksep=1.3, fontname="Helvetica"];
  node  [fontname="Helvetica", fontsize=13];
  edge  [fontname="Helvetica", fontsize=12, penwidth=1.6];

  node [shape=box, style="rounded,filled", fillcolor="#E8EEF8"];
  R1 [label="R1: Lock tabel stok\ntotal 10, tersedia 3"];
  R2 [label="R2: Lock transaksi pembayaran\ntotal 5, tersedia 3"];
  R3 [label="R3: Slot kurir\ntotal 7, tersedia 2"];

  node [shape=circle, style=filled, fillcolor="#FFF4D6"];
  {rank=same; R1; R2; R3;}
  {rank=same; P0; P1; P2; P3; P4;}

  R2 -> P0 [label=" 1"];
  R1 -> P1 [label=" 2"];
  R1 -> P2 [label=" 3"]; R3 -> P2 [label=" 2"];
  R1 -> P3 [label=" 2"]; R2 -> P3 [label=" 1"]; R3 -> P3 [label=" 1"];
  R3 -> P4 [label=" 2"];
}
